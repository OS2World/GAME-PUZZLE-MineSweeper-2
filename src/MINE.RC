
#include <os2.h>
#include "mine.h"

ICON     ID_WINDOW  images\bomb.ico

BITMAP  BM_0    images\0.bmp
BITMAP  BM_1    images\1.bmp
BITMAP  BM_2    images\2.bmp
BITMAP  BM_3    images\3.bmp
BITMAP  BM_4    images\4.bmp
BITMAP  BM_5    images\5.bmp
BITMAP  BM_6    images\6.bmp
BITMAP  BM_7    images\7.bmp
BITMAP  BM_8    images\8.bmp
BITMAP  BM_9    images\8.bmp
BITMAP  BM_BOMB   images\bomb.bmp
BITMAP  BM_CHECK  images\check.bmp
BITMAP  BM_ILL    images\ill.bmp
BITMAP  BM_FAIL   images\fail.bmp
BITMAP  BM_FACED  images\face1.bmp
BITMAP  BM_FACE1  images\face2.bmp
BITMAP  BM_FACE2  images\face3.bmp
BITMAP  BM_FACE3  images\face4.bmp
BITMAP  BM_FACE4  images\face5.bmp
BITMAP  BM_ASK1   images\ask1.bmp
BITMAP  BM_ASK2   images\ask2.bmp
BITMAP  BM_EMPTY  images\empty.bmp
